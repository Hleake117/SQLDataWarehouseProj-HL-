/*
====================================================================================
Stored Procedure: Load Silver Layer (Bronze -> Silver)
====================================================================================
Script Purpose:
    This stored procedure loads data into the 'silver' schema from the
    'bronze' schema, cleaning and standardizing it along the way.
    It performs the following actions:
    - Truncates the silver tables before loading the data.
    - Inserts transformed and cleansed data from bronze into silver tables.

Parameters:
    None.
    This stored procedure does not accept any parameters or return any values.

Before running:
    silver.crm_sales_details must have DATE columns for sls_order_dt,
    sls_ship_dt and sls_due_dt (not INT / TINYINT).

Usage Example:
    EXEC silver.load_silver;
====================================================================================
*/

CREATE OR ALTER PROCEDURE silver.load_silver AS
BEGIN
    DECLARE @start_time DATETIME, @end_time DATETIME, @batch_start_time DATETIME, @batch_end_time DATETIME;
    BEGIN TRY
        SET @batch_start_time = GETDATE();
        PRINT '===============================';
        PRINT 'Loading Silver Layer';
        PRINT '===============================';

        --shows when CRM tables begin
        PRINT '------------------------------';
        PRINT 'Loading CRM Tables';
        PRINT '------------------------------';

        /* ------------------------------------------------------------------
           silver.crm_cust_info
        ------------------------------------------------------------------ */
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.crm_cust_info';
        -- TRUNCATE removes every row but keeps the table and its columns.
        -- Faster than DELETE because it doesn't log each row individually.
        TRUNCATE TABLE silver.crm_cust_info;

        PRINT '>> Inserting Data Into: silver.crm_cust_info';
        -- INSERT ... SELECT matches columns by POSITION, not by name,
        -- so the SELECT list must be in the same order as this column list.
        INSERT INTO silver.crm_cust_info (
            cst_id,
            cst_key,
            cst_firstname,
            cst_lastname,
            cst_material_status,
            cst_gndr,
            cst_create_date
        )
        SELECT
            cst_id,
            cst_key,

            -- TRIM removes leading and trailing spaces ("  John " -> "John").
            TRIM(cst_firstname) AS cst_firstname,
            TRIM(cst_lastname)  AS cst_lastname,

            -- CASE turns short codes into readable values.
            -- UPPER(TRIM(...)) makes the comparison work for ' s', 'S ', 's', etc.
            CASE WHEN UPPER(TRIM(cst_material_status)) = 'S' THEN 'Single'
                 WHEN UPPER(TRIM(cst_material_status)) = 'M' THEN 'Married'
                 ELSE 'n/a'                                   -- anything else or NULL
            END AS cst_material_status,

            CASE WHEN UPPER(TRIM(cst_gndr)) = 'F' THEN 'Female'
                 WHEN UPPER(TRIM(cst_gndr)) = 'M' THEN 'Male'
                 ELSE 'n/a'
            END AS cst_gndr,

            cst_create_date
        FROM (
            SELECT
                *,
                -- ROW_NUMBER numbers the rows within each customer (PARTITION BY cst_id),
                -- newest first (ORDER BY cst_create_date DESC). The newest record gets 1.
                ROW_NUMBER() OVER (PARTITION BY cst_id ORDER BY cst_create_date DESC) AS flag_last
            FROM bronze.crm_cust_info
            WHERE cst_id IS NOT NULL          -- drop rows with no customer ID
        ) t
        WHERE flag_last = 1;                  -- keep only the latest record per customer (removes duplicates)

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS VARCHAR) + ' seconds';
        PRINT '>> ---------------------------';


        /* ------------------------------------------------------------------
           silver.crm_prd_info
        ------------------------------------------------------------------ */
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.crm_prd_info';
        TRUNCATE TABLE silver.crm_prd_info;

        PRINT '>> Inserting Data Into: silver.crm_prd_info';
        INSERT INTO silver.crm_prd_info (
            prd_id,
            cat_id,
            prd_key,
            prd_nm,
            prd_cost,
            prd_line,
            prd_start_dt,
            prd_end_dt
        )
        SELECT
            prd_id,

            -- The first 5 characters of prd_key are the category (e.g. 'CO-RF').
            -- SUBSTRING(text, start, length) cuts out part of a string.
            -- REPLACE swaps '-' for '_' so it matches the id in erp_px_cat_g1v2 ('CO_RF').
            REPLACE(SUBSTRING(prd_key, 1, 5), '-', '_') AS cat_id,

            -- Everything from the 7th character on is the actual product key,
            -- which matches sls_prd_key in crm_sales_details.
            SUBSTRING(prd_key, 7, LEN(prd_key)) AS prd_key,

            prd_nm,

            -- ISNULL replaces a NULL with the value given (here 0),
            -- so missing costs don't break calculations later.
            ISNULL(prd_cost, 0) AS prd_cost,

            -- Simple CASE: compares one expression against each WHEN value.
            CASE UPPER(TRIM(prd_line))
                 WHEN 'M' THEN 'Mountain'
                 WHEN 'R' THEN 'Road'
                 WHEN 'S' THEN 'Other Sales'
                 WHEN 'T' THEN 'Touring'
                 ELSE 'n/a'
            END AS prd_line,

            -- CAST to DATE drops the time part, which is always 00:00 here.
            CAST(prd_start_dt AS DATE) AS prd_start_dt,

            -- LEAD looks ahead to the NEXT row's value within the same product,
            -- ordered by start date. A version ends the day before the next one starts.
            -- The latest version has no next row, so its end date is NULL (still current).
            CAST(LEAD(prd_start_dt) OVER (PARTITION BY prd_key ORDER BY prd_start_dt) - 1 AS DATE) AS prd_end_dt
        FROM bronze.crm_prd_info;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS VARCHAR) + ' seconds';
        PRINT '>> ---------------------------';


        /* ------------------------------------------------------------------
           silver.crm_sales_details
        ------------------------------------------------------------------ */
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.crm_sales_details';
        TRUNCATE TABLE silver.crm_sales_details;

        PRINT '>> Inserting Data Into: silver.crm_sales_details';
        INSERT INTO silver.crm_sales_details (
            sls_ord_num,
            sls_prd_key,
            sls_crust_id,
            sls_order_dt,
            sls_ship_dt,
            sls_due_dt,
            sls_sales,
            sls_quantity,
            sls_price
        )
        SELECT
            sls_ord_num,
            sls_prd_key,
            sls_crust_id,

            -- Dates arrive as integers like 20101229 (YYYYMMDD).
            -- 0 or anything that isn't exactly 8 digits (LEN != 8) is invalid -> NULL.
            -- An INT can't be cast straight to DATE, so it goes INT -> VARCHAR -> DATE.
            CASE WHEN sls_order_dt = 0 OR LEN(sls_order_dt) != 8 THEN NULL
                 ELSE CAST(CAST(sls_order_dt AS VARCHAR) AS DATE)
            END AS sls_order_dt,

            CASE WHEN sls_ship_dt = 0 OR LEN(sls_ship_dt) != 8 THEN NULL
                 ELSE CAST(CAST(sls_ship_dt AS VARCHAR) AS DATE)
            END AS sls_ship_dt,

            CASE WHEN sls_due_dt = 0 OR LEN(sls_due_dt) != 8 THEN NULL
                 ELSE CAST(CAST(sls_due_dt AS VARCHAR) AS DATE)
            END AS sls_due_dt,

            -- Business rule: sales = quantity * price.
            -- If sales is missing, zero/negative, or doesn't match, recalculate it.
            -- ABS returns the absolute value, so a negative price is treated as positive.
            CASE WHEN sls_sales IS NULL OR sls_sales <= 0 OR sls_sales != sls_quantity * ABS(sls_price)
                 THEN sls_quantity * ABS(sls_price)
                 ELSE sls_sales
            END AS sls_sales,

            sls_quantity,                      -- kept here so the order matches the INSERT list

            -- If price is missing or zero/negative, derive it: price = sales / quantity.
            -- NULLIF(sls_quantity, 0) returns NULL when quantity is 0,
            -- which avoids a "divide by zero" error (the result is just NULL).
            -- Note: this uses the ORIGINAL bronze sls_sales, not the corrected value above.
            CASE WHEN sls_price IS NULL OR sls_price <= 0
                 THEN sls_sales / NULLIF(sls_quantity, 0)
                 ELSE sls_price
            END AS sls_price
        FROM bronze.crm_sales_details;         -- read from BRONZE (the source), not silver

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS VARCHAR) + ' seconds';
        PRINT '>> ---------------------------';


        --shows when ERP tables begin
        PRINT '------------------------------';
        PRINT 'Loading ERP Tables';
        PRINT '------------------------------';

        /* ------------------------------------------------------------------
           silver.erp_cust_az12
        ------------------------------------------------------------------ */
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.erp_cust_az12';
        TRUNCATE TABLE silver.erp_cust_az12;

        PRINT '>> Inserting Data Into: silver.erp_cust_az12';
        INSERT INTO silver.erp_cust_az12 (
            cid,
            bdate,
            gen
        )
        SELECT
            -- Some IDs have an extra 'NAS' prefix (e.g. 'NASAW00011000').
            -- LIKE 'NAS%' finds IDs that start with NAS (% = any characters after).
            -- SUBSTRING(cid, 4, LEN(cid)) keeps everything from the 4th character on,
            -- so the ID matches cst_key in crm_cust_info and the tables can be joined.
            CASE WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid, 4, LEN(cid))
                 ELSE cid
            END AS cid,

            -- GETDATE() returns the current date and time.
            -- A birthdate in the future is impossible, so it's set to NULL.
            CASE WHEN bdate > GETDATE() THEN NULL
                 ELSE bdate
            END AS bdate,

            -- Normalize gender values. IN (...) checks against a list of values.
            -- UPPER makes the input uppercase, so the list values are uppercase too.
            CASE WHEN UPPER(TRIM(gen)) IN ('F', 'FEMALE') THEN 'Female'
                 WHEN UPPER(TRIM(gen)) IN ('M', 'MALE')   THEN 'Male'
                 ELSE 'n/a'                               -- blanks, NULLs, unknown values
            END AS gen
        FROM bronze.erp_cust_az12;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS VARCHAR) + ' seconds';
        PRINT '>> ---------------------------';


        /* ------------------------------------------------------------------
           silver.erp_loc_a101
        ------------------------------------------------------------------ */
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.erp_loc_a101';
        TRUNCATE TABLE silver.erp_loc_a101;

        PRINT '>> Inserting Data Into: silver.erp_loc_a101';
        INSERT INTO silver.erp_loc_a101 (
            cid,
            cntry
        )
        SELECT
            -- IDs arrive with a dash (e.g. 'AW-00011000').
            -- REPLACE(cid, '-', '') swaps every '-' for nothing, removing it,
            -- so the ID matches cst_key in crm_cust_info and the tables can be joined.
            REPLACE(cid, '-', '') AS cid,

            -- Turn country codes into full names and handle missing values.
            -- TRIM removes stray spaces so ' US ' still matches 'US'.
            -- The empty-string/NULL check comes before ELSE, so blanks become 'n/a'
            -- instead of passing through as empty values.
            CASE WHEN TRIM(cntry) = 'DE'               THEN 'Germany'
                 WHEN TRIM(cntry) IN ('US', 'USA')     THEN 'United States'
                 WHEN TRIM(cntry) = '' OR cntry IS NULL THEN 'n/a'
                 ELSE TRIM(cntry)                      -- any other country, just cleaned of spaces
            END AS cntry
        FROM bronze.erp_loc_a101;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS VARCHAR) + ' seconds';
        PRINT '>> ---------------------------';


        /* ------------------------------------------------------------------
           silver.erp_px_cat_g1v2
        ------------------------------------------------------------------ */
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.erp_px_cat_g1v2';
        TRUNCATE TABLE silver.erp_px_cat_g1v2;

        PRINT '>> Inserting Data Into: silver.erp_px_cat_g1v2';
        -- This source is already clean: the quality checks found no extra spaces
        -- and consistent category/maintenance values, so it's copied as-is.
        -- It still goes through silver so every table follows the same
        -- bronze -> silver -> gold path.
        INSERT INTO silver.erp_px_cat_g1v2 (
            id,
            cat,
            subcat,
            maintainance
        )
        SELECT
            id,
            cat,
            subcat,
            maintainance
        FROM bronze.erp_px_cat_g1v2;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS VARCHAR) + ' seconds';
        PRINT '>> ---------------------------';


        SET @batch_end_time = GETDATE();
        PRINT '======================================';
        PRINT 'Loading Silver Layer Is Completed';
        PRINT '   - Total Load Duration: ' + CAST(DATEDIFF(second, @batch_start_time, @batch_end_time) AS NVARCHAR) + ' seconds';
        PRINT '======================================';

    END TRY
    BEGIN CATCH
        -- Runs only if any statement inside BEGIN TRY fails.
        -- The ERROR_ functions describe the error that sent control here.
        PRINT '=====================================';
        PRINT 'ERROR OCCURRED DURING LOADING SILVER LAYER';
        PRINT 'Error Message: ' + ERROR_MESSAGE();
        PRINT 'Error Number: '  + CAST(ERROR_NUMBER() AS NVARCHAR);
        PRINT 'Error State: '   + CAST(ERROR_STATE() AS NVARCHAR);
        PRINT '=====================================';
    END CATCH
END
